{
  "name": "smile",
  "displayName": "Smile",
  "description": "Visual Studio–style project integration: properties, keyboard shortcuts, and C++ colors",
  "version": "1.0.0",
  "publisher": "smile",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B121A",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flashknife268/smile.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:smile.sidebar",
    "onCommand:smile.openPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smile.openPanel",
        "title": "Smile: Open Project Integration",
        "icon": {
          "light": "media/smile.svg",
          "dark": "media/smile.svg"
        }
      },
      {
        "command": "smile.refresh",
        "title": "Smile: Refresh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smile",
          "title": "Smile",
          "icon": "media/smile.svg"
        }
      ]
    },
    "views": {
      "smile": [
        {
          "type": "webview",
          "id": "smile.sidebar",
          "name": "Smile"
        }
      ]
    },
    "keybindings": [
      { "key": "alt+e", "command": "editor.action.revealDefinition", "when": "editorHasDefinitionProvider && editorTextFocus" },
      { "key": "alt+w", "command": "C_Cpp.CreateDeclarationOrDefinition" },
      { "key": "alt+q", "command": "C_Cpp.SwitchHeaderSource", "when": "editorTextFocus && editorLangId =~ /^(c|(cuda-)?cpp)$/" },
      { "key": "alt+right", "command": "workbench.action.navigateForward" },
      { "key": "alt+left", "command": "workbench.action.navigateBack" },
      { "key": "ctrl+f", "command": "actions.find", "when": "editorFocus || editorIsOpen" },
      { "key": "ctrl+t", "command": "workbench.action.showAllSymbols" },
      { "key": "alt+r", "command": "editor.action.goToReferences", "when": "editorHasReferenceProvider && editorTextFocus && !isInEmbeddedEditor" },
      { "key": "alt+s", "command": "editor.action.formatSelection", "when": "editorHasDocumentSelectionFormattingProvider && editorTextFocus && !editorReadonly" },
      { "key": "f6", "command": "workbench.action.tasks.build", "when": "taskCommandsRegistered" },
      { "key": "alt+d", "command": "editor.action.deleteLines", "when": "textInputFocus && !editorReadonly" },
      { "key": "ctrl+d", "command": "editor.action.copyLinesDownAction", "when": "editorTextFocus && !editorReadonly" },
      { "key": "alt+up", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus && !editorReadonly" },
      { "key": "alt+down", "command": "editor.action.moveLinesDownAction", "when": "editorTextFocus && !editorReadonly" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
